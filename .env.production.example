APP_NAME=SIGAP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://supportfkip.unsil.ac.id/sigap
APP_VERSION=1.0.0
APP_KODE=sigap

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB native di HOST (bukan container) — dari dalam container, localhost adalah container itu sendiri.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_sigap
DB_USERNAME=sigap
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Profil Ringan (STANDAR-TEKNIS §1b): tanpa Horizon/Redis. Sesi, cache, dan antrean memakai database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# SESSION_PATH menjaga cookie sesi tidak bertabrakan dengan aplikasi lain di domain yang sama.
SESSION_PATH=/sigap
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Diisi hanya bila SIGAP berada di belakang server balik. '*' berarti mempercayai header
# X-Forwarded-* dari siapa pun yang bisa menjangkau PHP — aman HANYA bila PHP tidak terbuka
# langsung ke jaringan (di sini memang tidak, hanya loopback — lihat compose.prod.yaml).
TRUSTED_PROXIES=*

# Port loopback web (reverse proxy Apache fakultas meneruskan /sigap ke sini).
WEB_PORT=8019

# Cadangan basis data harian (docker/scripts/cadangan.sh).
CADANGAN_HARI=30
CADANGAN_JAM=02:00
