APP_NAME=SIGAP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8021

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB berjalan di HOST (WSL); container menjangkaunya lewat host.docker.internal.
# Bukan localhost — dari dalam container, localhost adalah container itu sendiri.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_sigap
DB_USERNAME=app
DB_PASSWORD=app123
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Disk umum. Bukti akreditasi TIDAK memakai ini — ia punya disk sendiri
# bernama `bukti` (storage/app/bukti), didefinisikan di config/filesystems.php
# dan tidak pernah ikut riwayat git.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Penggelaran di server — https://supportfkip.unsil.ac.id/sigap
# ---------------------------------------------------------------------------
# Salin blok ini ke .env server dan HAPUS nilai lokal di atasnya. Jangan
# menyalin .env ini apa adanya: APP_DEBUG=true di server membocorkan jejak
# tumpukan, isi .env, dan seluruh kueri kepada siapa pun yang memicu galat.
#
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://supportfkip.unsil.ac.id/sigap
#
# APP_URL memuat subfolder /sigap, dan itulah satu-satunya sumber yang dipakai
# App\Support\Pemasangan untuk membangun tautan. Salah tulis di sini berarti
# setiap tombol menunjuk ke luar aplikasi — sementara halaman mukanya tetap
# tampil, jadi kelihatan berhasil sampai ada yang menekan tombol.
#
#   SESSION_PATH=/sigap
#   SESSION_SECURE_COOKIE=true
#
# SESSION_PATH menjaga cookie sesi tidak bertabrakan dengan aplikasi lain di
# domain yang sama. Tanpa itu, masuk ke SIGAP bisa mengeluarkan orang dari
# aplikasi tetangga, dan sebaliknya.
#
#   TRUSTED_PROXIES=*
#
# Diisi hanya bila SIGAP berada di belakang server balik. '*' berarti
# mempercayai header X-Forwarded-* dari siapa pun yang bisa menjangkau PHP —
# aman HANYA bila PHP tidak terbuka langsung ke jaringan. Bila ragu, tulis
# alamat IP proksinya, dipisah koma.
#
# Sesudah menyalin, jalankan di server:
#   php artisan sigap:cek-kesiapan
